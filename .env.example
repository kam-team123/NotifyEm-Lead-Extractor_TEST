# Copy to .env.local for `npm run dev`; set the same keys in Vercel → Project → Settings → Environment Variables.
# Server-only: none of these are exposed to the browser (no VITE_ prefix needed).

# --- Supabase (required for saving leads, listings, imports) -------------------------
# Project Settings → API. Use the service_role / secret key: it stays on the server.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- MLS feed (RESO Web API) -----------------------------------------------------------
# Bridge Interactive:  MLS_RESO_URL=https://api.bridgedataoutput.com/api/v2/OData/<dataset>  + MLS_ACCESS_TOKEN
# MLS Grid:            MLS_RESO_URL=https://api.mlsgrid.com/v2  + MLS_ACCESS_TOKEN
#                      MLS_FILTER=OriginatingSystemName eq '<mls code>' and MlgCanView eq true   MLS_EXPAND=Media
# Spark / Flexmls:     MLS_RESO_URL=https://replication.sparkapi.com/Reso/OData  + MLS_ACCESS_TOKEN
# Trestle (OAuth):     MLS_RESO_URL=https://api-trestle.corelogic.com/trestle/odata
#                      MLS_OAUTH_TOKEN_URL=https://api-trestle.corelogic.com/trestle/oidc/connect/token
#                      MLS_CLIENT_ID=  MLS_CLIENT_SECRET=  MLS_OAUTH_SCOPE=api   MLS_EXPAND=Media
# Sandbox (synthetic, flagged TEST DATA in the UI): MLS_PROVIDER=bridge-test
MLS_RESO_URL=
MLS_ACCESS_TOKEN=
MLS_NAME=
# MLS_STATUSES=Active,Active Under Contract,Coming Soon,Pending
# MLS_MAX_RECORDS=1000

# Vercel Cron sends this as a Bearer token to /api/mls/sync (daily, see vercel.json).
CRON_SECRET=

# --- Optional -------------------------------------------------------------------------------
# NOMINATIM_EMAIL=you@example.com     # identifies the app to Nominatim (recommended by OSM policy)
# OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
